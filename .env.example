# --- Base de données ---------------------------------------------------------
# SQLite en développement. En production, préférez PostgreSQL :
# changez provider = "postgresql" dans prisma/schema.prisma puis l'URL ci-dessous.
DATABASE_URL="file:./dev.db"

# --- Application -------------------------------------------------------------
# URL publique du site (utilisée pour les retours de paiement, le SEO, les reçus)
APP_URL="http://localhost:3000"
# Secret de session : 32+ caractères aléatoires (ex : openssl rand -base64 48)
SESSION_SECRET="remplacez-moi-par-une-longue-chaine-aleatoire-de-48-caracteres"
# Jeton pour l'appel planifié des rappels d'engagements mensuels (/api/cron/recurring)
CRON_SECRET="remplacez-moi"

# --- Compte administrateur initial (utilisé uniquement par npm run db:seed) ---
SEED_ADMIN_EMAIL="admin@exemple.sn"
SEED_ADMIN_PASSWORD="ChangezCeMotDePasse!2026"

# --- Wave Business (Checkout API) -------------------------------------------
# https://docs.wave.com/checkout — clé API "Checkout" et secret de webhook
WAVE_API_KEY=""
WAVE_WEBHOOK_SECRET=""
WAVE_API_BASE="https://api.wave.com"

# --- Orange Money Sénégal (API Sonatel) -------------------------------------
# Identifiants fournis par Sonatel lors de l'ouverture du compte marchand.
ORANGE_CLIENT_ID=""
ORANGE_CLIENT_SECRET=""
ORANGE_MERCHANT_CODE=""
ORANGE_MERCHANT_NAME="DALAL JAAM SOLIDAIRE"
ORANGE_API_BASE="https://api.orange-sonatel.com"
# Secret partagé ajouté à l'URL de notification déclarée auprès de Sonatel
ORANGE_WEBHOOK_SECRET=""
# "api" (défaut, recommandé) ou "callback" — voir README
ORANGE_VERIFY_MODE="api"
# Chemins API Sonatel (à valider en recette)
# ORANGE_TOKEN_PATH="/oauth/v1/token"
# ORANGE_QRCODE_PATH="/api/eWallet/v4/qrcode"
# ORANGE_STATUS_PATH="/api/eWallet/v1/transactions/{transactionId}/status"
